{
  "name": "finance-mosaix",
  "version": "0.2.0",
  "private": true,
  "description": "Electron wrapper for the Finance Mosaix Streamlit dashboard.",
  "author": "Developer-Simon",
  "repository": {
    "type": "git",
    "url": "https://github.com/Developer-Simon/finance-mosaix.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node --test \"test/**/*.test.js\"",
    "build:requirements": "python3 scripts/write_requirements.py || python scripts/write_requirements.py",
    "build:runtime": "npm run build:requirements && node runtime/build-runtime.js",
    "sync-version": "node sync_version.js",
    "dist:slim": "npm run build:requirements && electron-builder --config electron-builder.yml --publish never",
    "dist:full": "electron-builder --config electron-builder.full.yml --publish never"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
